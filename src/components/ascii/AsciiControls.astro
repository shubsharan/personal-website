---
import { Icon } from 'astro-icon/components';
import {
	COLORS,
	CONTRASTS,
	DEFAULTS,
	RAMP_ORDER,
	RESOLUTIONS,
	SPEEDS,
	indexOfKey,
} from './config.mjs';

// Base reset shared by every toggle; most also dim -> lit on hover / active.
const btn = 'cursor-pointer border-0 bg-transparent p-0 transition-colors';
const toggle = `${btn} inline-flex items-center text-tx-3 hover:text-tx aria-pressed:text-tx`;
// A ramp toggle shows a few sample glyphs of its style, in mono.
const rampBtn = `${toggle} font-mono text-[0.8em] normal-case tracking-[0.05em]`;

// Color swatch: a hued dot (::before); the selected one gains a ring.
const swatch = `${btn} leading-[0] before:block before:h-[9px] before:w-[9px] before:rounded-full before:opacity-65 before:content-[''] before:[transition:opacity_0.15s_ease,box-shadow_0.15s_ease] hover:before:opacity-100 aria-pressed:before:opacity-100 aria-pressed:before:shadow-[0_0_0_1px_var(--bg),0_0_0_2px_var(--tx)]`;

// A control group (buttons cluster tightly) and the rule that divides groups.
const group = 'inline-flex items-center gap-[0.4rem]';
const divider = 'h-[0.95em] w-px flex-none bg-ui-3';

const iconSize = 12;
const detailLevel = indexOfKey(RESOLUTIONS, 'key', DEFAULTS.res);
const contrastLevel = indexOfKey(CONTRASTS, 'value', DEFAULTS.contrast);
const speedLevel = indexOfKey(SPEEDS, 'fps', DEFAULTS.fps);
---

<div
	class="label py-2 border-b border-ui bg-bg-2 flex flex-wrap items-center justify-between gap-x-4 gap-y-0.5 px-6 text-tx-3 max-[40rem]:gap-x-2 max-[40rem]:text-xs"
>
	<a
		class="whitespace-nowrap text-tx-3 no-underline transition-colors hover:text-tx"
		href="https://www.youtube.com/watch?v=ry55--J4_VQ&t=38s"
		target="_blank"
		rel="noreferrer">[src]</a>

	<div
		class="flex flex-wrap items-center gap-x-[0.8rem] gap-y-[0.3rem]"
		data-ascii-controls
		hidden
	>
		<span class={group} role="group" aria-label="Detail">
			<button
				type="button"
				class={`group ${toggle}`}
				data-detail
				data-level={detailLevel}
				aria-label="Detail"
			>
				<Icon name="lucide:grid-2x2" width={iconSize} height={iconSize} class="hidden group-data-[level=0]:block" aria-hidden="true" />
				<Icon name="lucide:grid-3x2" width={iconSize} height={iconSize} class="hidden group-data-[level=1]:block" aria-hidden="true" />
				<Icon name="lucide:grid-3x3" width={iconSize} height={iconSize} class="hidden group-data-[level=2]:block" aria-hidden="true" />
			</button>
		</span>

		<span class={divider} aria-hidden="true"></span>

		<span class={group} role="group" aria-label="Color">
			{
				COLORS.map((c) => (
					<button
						type="button"
						class={`${swatch} ${c.dot}`}
						data-color={c.key}
						aria-pressed={c.key === DEFAULTS.color}
						aria-label={c.label}
					/>
				))
			}
		</span>

		<span class={divider} aria-hidden="true"></span>

		<span class="inline-flex items-center gap-[0.5rem]" role="group" aria-label="Style">
			{
				RAMP_ORDER.map((r) => (
					<button type="button" class={rampBtn} data-ramp={r.key} aria-pressed={r.key === DEFAULTS.ramp} aria-label={r.label}>{r.sample}</button>
				))
			}
		</span>

		<span class={divider} aria-hidden="true"></span>

		<span class={group} role="group" aria-label="Contrast">
			<button
				type="button"
				class={`group ${toggle} gap-1`}
				data-contrast-cycle
				data-level={contrastLevel}
				aria-label="Contrast"
			>
				<Icon name="lucide:contrast" width={iconSize} height={iconSize} aria-hidden="true" />
				<span class="inline-flex items-center gap-0.5" aria-hidden="true">
					<span
						class="h-2.5 w-[3px] rounded-sm bg-current opacity-30 group-data-[level=0]:opacity-100 group-data-[level=1]:opacity-100 group-data-[level=2]:opacity-100"
					></span>
					<span
						class="h-2.5 w-[3px] rounded-sm bg-current opacity-30 group-data-[level=1]:opacity-100 group-data-[level=2]:opacity-100"
					></span>
					<span
						class="h-2.5 w-[3px] rounded-sm bg-current opacity-30 group-data-[level=2]:opacity-100"
					></span>
				</span>
			</button>
		</span>

		<span class={divider} aria-hidden="true"></span>

		<span class={group} role="group" aria-label="Speed">
			<button
				type="button"
				class={`group ${toggle}`}
				data-speed
				data-level={speedLevel}
				aria-label="Speed"
			>
				<Icon name="lucide:turtle" width={iconSize} height={iconSize} class="hidden group-data-[level=0]:block" aria-hidden="true" />
				<Icon name="lucide:play" width={iconSize} height={iconSize} class="hidden group-data-[level=1]:block" aria-hidden="true" />
				<Icon name="lucide:rabbit" width={iconSize} height={iconSize} class="hidden group-data-[level=2]:block" aria-hidden="true" />
			</button>
		</span>

		<span class={divider} aria-hidden="true"></span>

		<span class={group} role="group" aria-label="Invert">
			<button
				type="button"
				class={`${btn} inline-flex items-center gap-[3px] align-middle text-tx-3 hover:text-tx before:box-border before:h-[9px] before:w-[9px] before:rounded-full before:border before:border-current before:bg-current before:content-[''] after:box-border after:h-[9px] after:w-[9px] after:rounded-full after:border after:border-current after:content-[''] aria-pressed:before:bg-transparent aria-pressed:after:bg-current`}
				data-invert
				aria-pressed="false"
				aria-label="Invert light and dark"
			></button>
		</span>
	</div>
</div>
