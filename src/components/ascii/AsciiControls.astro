---
import { Icon } from "astro-icon/components";
import {
  COLORS,
  CONTRASTS,
  DEFAULTS,
  RAMP_ORDER,
  RESOLUTIONS,
  SPEEDS,
  indexOfKey,
} from "./config.mjs";

const detailLevel = indexOfKey(RESOLUTIONS, "key", DEFAULTS.res);
const contrastLevel = indexOfKey(CONTRASTS, "value", DEFAULTS.contrast);
const speedLevel = indexOfKey(SPEEDS, "fps", DEFAULTS.fps);

const DETAIL_ICONS = ["lucide:grid-2x2", "lucide:grid-3x2", "lucide:grid-3x3"];
const SPEED_ICONS = ["lucide:turtle", "lucide:play", "lucide:rabbit"];

const toggleClass =
  "inline-flex items-center text-tx-3 transition-colors hover:text-tx aria-pressed:text-tx";
const swatchClass =
  "leading-none transition-colors before:block before:size-2.5 before:rounded-full before:opacity-65 before:content-[''] before:transition hover:before:opacity-100 aria-pressed:before:opacity-100 aria-pressed:before:ring-1 aria-pressed:before:ring-tx aria-pressed:before:ring-offset-1 aria-pressed:before:ring-offset-bg";
const rampClass =
  "inline-flex items-center font-mono text-sm leading-none tracking-wider text-tx-3 normal-case transition-colors hover:text-tx aria-pressed:text-tx";
const invertClass =
  "inline-flex items-center gap-0.5 align-middle text-tx-3 transition-colors hover:text-tx before:box-border before:size-2.5 before:rounded-full before:border before:border-current before:bg-tx before:content-[''] after:box-border after:size-2.5 after:rounded-full after:border after:border-current after:content-[''] aria-pressed:before:bg-transparent aria-pressed:after:bg-tx";
const groupClass = "inline-flex items-center gap-1.5";
const dividerClass = "hidden h-3.5 w-px flex-none bg-ui-3 md:block";
---

<div
  class='flex flex-wrap items-center justify-between p-2 gap-4 font-mono text-xs tracking-wide text-tx-3 tabular-nums'
>
  <a
    class='whitespace-nowrap text-tx-3 no-underline transition-colors hover:text-tx'
    href='https://www.youtube.com/watch?v=ry55--J4_VQ&t=38s'
    target='_blank'
    rel='noreferrer'>[src]</a
  >

  <details data-ascii-controls-wrap class='relative md:static' hidden>
    <summary
      class='inline-flex h-6 w-6 list-none items-center justify-center rounded text-tx-3 transition-colors hover:text-tx md:hidden [&::-webkit-details-marker]:hidden [&::marker]:hidden'
      aria-label='Controls'
    >
      <Icon name='lucide:ellipsis' width={20} height={20} aria-hidden='true' />
    </summary>

    <div
      class='absolute top-full right-0 z-20 grid grid-cols-[auto_1fr] items-center gap-x-6 gap-y-4 rounded-md border border-ui bg-bg-2 p-4 shadow-lg md:static md:z-auto md:flex md:flex-row md:flex-wrap md:items-center md:gap-x-4 md:gap-y-1 md:rounded-none md:border-0 md:bg-transparent md:p-0 md:shadow-none'
      data-ascii-controls
      hidden
    >
      <span
        class='contents md:inline-flex md:items-center md:gap-1.5'
        role='group'
        aria-label='Detail'
      >
        <span class='md:hidden'>Detail</span>
        <button
          type='button'
          class:list={[
            "group hidden justify-self-end md:inline-flex md:justify-self-auto",
            toggleClass,
          ]}
          data-detail
          data-level={detailLevel}
          aria-label='Detail'
        >
          <Icon
            name='lucide:grid-2x2'
            size={14}
            class='hidden group-data-[level=0]:block'
            aria-hidden='true'
          />
          <Icon
            name='lucide:grid-3x2'
            size={14}
            class='hidden group-data-[level=1]:block'
            aria-hidden='true'
          />
          <Icon
            name='lucide:grid-3x3'
            size={14}
            class='hidden group-data-[level=2]:block'
            aria-hidden='true'
          />
        </button>
        <span class:list={[groupClass, "justify-self-end md:hidden"]}>
          {
            RESOLUTIONS.map((r, i) => (
              <button
                type='button'
                class={toggleClass}
                data-detail-option={r.key}
                aria-pressed={r.key === DEFAULTS.res}
                aria-label={`Detail: ${r.label}`}
              >
                <Icon name={DETAIL_ICONS[i]} size={14} aria-hidden='true' />
              </button>
            ))
          }
        </span>
      </span>

      <span class={dividerClass} aria-hidden='true'></span>

      <span
        class='contents md:inline-flex md:items-center md:gap-1.5'
        role='group'
        aria-label='Color'
      >
        <span class='md:hidden'>Color</span>
        <span
          class:list={[groupClass, "justify-self-end md:justify-self-auto"]}
        >
          {
            COLORS.map((c) => (
              <button
                type='button'
                class={`${swatchClass} ${c.dot}`}
                data-color={c.key}
                aria-pressed={c.key === DEFAULTS.color}
                aria-label={c.label}
              />
            ))
          }
        </span>
      </span>

      <span class={dividerClass} aria-hidden='true'></span>

      <span
        class='contents md:inline-flex md:items-center md:gap-1.5'
        role='group'
        aria-label='Style'
      >
        <span class='md:hidden'>Style</span>
        <span
          class='inline-flex items-center gap-2 justify-self-end md:justify-self-auto'
        >
          {
            RAMP_ORDER.map((r) => (
              <button
                type='button'
                class={rampClass}
                data-ramp={r.key}
                aria-pressed={r.key === DEFAULTS.ramp}
                aria-label={r.label}
              >
                {r.sample}
              </button>
            ))
          }
        </span>
      </span>

      <span class={dividerClass} aria-hidden='true'></span>

      <span
        class='contents md:inline-flex md:items-center md:gap-1.5'
        role='group'
        aria-label='Contrast'
      >
        <span class='md:hidden'>Contrast</span>
        <button
          type='button'
          class:list={[
            "group hidden gap-1 justify-self-end md:inline-flex md:justify-self-auto",
            toggleClass,
          ]}
          data-contrast-cycle
          data-level={contrastLevel}
          aria-label='Contrast'
        >
          <Icon name='lucide:contrast' size={14} aria-hidden='true' />
          <span class='inline-flex items-center gap-0.5' aria-hidden='true'>
            <span
              class='h-3 w-1 rounded-sm bg-tx-3 group-data-[level=0]:bg-tx group-data-[level=1]:bg-tx group-data-[level=2]:bg-tx'
            ></span>
            <span
              class='h-3 w-1 rounded-sm bg-tx-3 group-data-[level=1]:bg-tx group-data-[level=2]:bg-tx'
            ></span>
            <span class='h-3 w-1 rounded-sm bg-tx-3 group-data-[level=2]:bg-tx'
            ></span>
          </span>
        </button>
        <button
          type='button'
          class:list={["group justify-self-end md:hidden", toggleClass]}
          data-contrast-cycle-mobile
          data-level={contrastLevel}
          aria-label='Contrast'
        >
          <span class='inline-flex items-center gap-0.5' aria-hidden='true'>
            <span
              class='h-3 w-1 rounded-sm bg-tx-3 group-data-[level=0]:bg-tx group-data-[level=1]:bg-tx group-data-[level=2]:bg-tx'
            ></span>
            <span
              class='h-3 w-1 rounded-sm bg-tx-3 group-data-[level=1]:bg-tx group-data-[level=2]:bg-tx'
            ></span>
            <span class='h-3 w-1 rounded-sm bg-tx-3 group-data-[level=2]:bg-tx'
            ></span>
          </span>
        </button>
      </span>

      <span class={dividerClass} aria-hidden='true'></span>

      <span
        class='contents md:inline-flex md:items-center md:gap-1.5'
        role='group'
        aria-label='Speed'
      >
        <span class='md:hidden'>Speed</span>
        <button
          type='button'
          class:list={[
            "group hidden justify-self-end md:inline-flex md:justify-self-auto",
            toggleClass,
          ]}
          data-speed
          data-level={speedLevel}
          aria-label='Speed'
        >
          <Icon
            name='lucide:turtle'
            size={14}
            class='hidden group-data-[level=0]:block'
            aria-hidden='true'
          />
          <Icon
            name='lucide:play'
            size={14}
            class='hidden group-data-[level=1]:block'
            aria-hidden='true'
          />
          <Icon
            name='lucide:rabbit'
            size={14}
            class='hidden group-data-[level=2]:block'
            aria-hidden='true'
          />
        </button>
        <span class:list={[groupClass, "justify-self-end md:hidden"]}>
          {
            SPEEDS.map((s, i) => (
              <button
                type='button'
                class={toggleClass}
                data-speed-option={s.fps}
                aria-pressed={s.fps === DEFAULTS.fps}
                aria-label={`Speed: ${s.name}`}
              >
                <Icon name={SPEED_ICONS[i]} size={14} aria-hidden='true' />
              </button>
            ))
          }
        </span>
      </span>

      <span class={dividerClass} aria-hidden='true'></span>

      <span
        class='contents md:inline-flex md:items-center md:gap-1.5'
        role='group'
        aria-label='Invert'
      >
        <span class='md:hidden'>Invert</span>
        <button
          type='button'
          class:list={[invertClass, "justify-self-end md:justify-self-auto"]}
          data-invert
          aria-pressed='false'
          aria-label='Invert light and dark'></button>
      </span>
    </div>
  </details>
</div>

<script>
  const wrap = document.querySelector<HTMLDetailsElement>(
    "[data-ascii-controls-wrap]",
  );
  const desktop = window.matchMedia("(min-width: 768px)");
  const syncOpen = (matches: boolean) => {
    if (wrap) wrap.open = matches;
  };
  syncOpen(desktop.matches);
  desktop.addEventListener("change", (e) => syncOpen(e.matches));
</script>
