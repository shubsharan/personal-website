---
import AsciiControls from "./AsciiControls.astro";
import data from "../../assets/apollo-ascii-fine.json";
import { POSTER_RAMP } from "./config.mjs";
import { buildLut, densestFrame, posterText } from "./frames.mjs";

const cols: number = data.cols;
const rows: number = data.rows;

const lut = buildLut(data.pack);
const poster = densestFrame(data.frames as string[], lut);
const posterLines = posterText(poster, { cols, rows, lut, ramp: POSTER_RAMP });
---

<figure
  class='animate-rise flex w-full flex-col delay-75 border-y border-border'
  data-ascii-frame
>
  <div class='@container relative' data-theme='dark'>
    <div
      class='relative aspect-[64/27] overflow-hidden bg-[radial-gradient(circle_at_50%_45%,var(--muted),var(--background)_72%)]'
      role='img'
      aria-label='Engineers spread improvised materials across a workbench, rendered as animated ASCII art.'
    >
      <pre
        class='absolute inset-0 m-0 box-border h-full w-full overflow-hidden whitespace-pre py-1 font-mono text-[clamp(0.3rem,1.1vw,0.6rem)] font-normal leading-none text-muted-foreground'
        data-ascii-fallback
        aria-hidden='true'>{posterLines}</pre>
      <canvas
        class='absolute inset-0 block h-full w-full opacity-0 transition-opacity duration-200 [&.is-ready]:opacity-100 motion-reduce:transition-none'
        data-ascii-canvas
        aria-hidden='true'></canvas>
    </div>
    <p
      class='pointer-events-none absolute top-1/2 left-1/2 m-0 w-11/12 -translate-x-1/2 -translate-y-1/2 p-0 text-center font-sans text-[clamp(2rem,3cqi,6rem)] leading-none tracking-wide text-foreground [&:not(.is-carved)]:[text-shadow:0_0_0.6em_var(--background),0_0_1.2em_var(--background)]'
      data-ascii-title
    >
      EVERYTHING ON THE TABLE
    </p>
  </div>

  <AsciiControls />
</figure>

<script>
  import { createAsciiScene } from "./scene";
  import { loadDefault, VARIANTS } from "./framesets";

  document
    .querySelectorAll<HTMLElement>("[data-ascii-frame]")
    .forEach((root) =>
      createAsciiScene(root, { loadDefault, variants: VARIANTS }),
    );
</script>
