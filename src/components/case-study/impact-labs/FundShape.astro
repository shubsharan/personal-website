---
// Fund-level "impact shape": breadth, depth and timeline form the triangle
// silhouette; evidence is the fill. Faint dots are the individual programs.
---

<div class="fs font-sans text-tx" data-fundshape>
	<div class="fs-tabs" data-tabs role="tablist" aria-label="Funds"></div>

	<hr class="fs-rule" />

	<div class="fs-body">
		<svg
			class="fs-viz"
			data-viz
			viewBox="34 2 256 174"
			role="img"
			aria-label="Impact shape of the selected fund"
		></svg>

		<div class="fs-detail">
			<p class="label text-tx-3">Fund average</p>
			<div class="fs-rows" data-rows></div>
		</div>
	</div>
</div>

<style is:global>
	/* Global + nested under .fs so styles reach the tabs and rows the script builds. */
	/* Tighten just this component's card shell (scoped via :has, not the shared class):
	   less padding, and hug the content instead of the full Breakout width. */
	.frame-float:has(.fs) {
		max-width: 45rem;
		margin-inline: auto;
		padding: 1.25rem;
	}
	.fs {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		line-height: 1.35;
	}
	.fs hr.fs-rule {
		border: 0;
		border-top: 1px solid var(--ui-2);
		margin: 0 -1.25rem; /* bleed past inline padding; no block margin */
	}
	.fs .fs-tabs {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
	}
	.fs .fs-tab {
		padding: 0;
		border: 0;
		background: none;
		cursor: pointer;
		font-size: 0.8125rem;
		font-weight: 500;
		color: var(--tx-2);
		text-decoration: underline;
		text-decoration-color: var(--ui-3);
		text-underline-offset: 0.25rem;
		transition: color 0.15s ease, text-decoration-color 0.15s ease;
	}
	.fs .fs-tab:hover,
	.fs .fs-tab[aria-selected='true'] {
		color: var(--tx);
		text-decoration-color: var(--accent);
	}
	.fs .fs-body {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 1.5rem;
		align-items: center;
	}
	.fs .fs-viz {
		width: 15rem;
		max-width: 100%;
		height: auto;
		justify-self: center;
	}
	.fs .fs-poly,
	.fs .fs-vert,
	.fs .fs-dot {
		transition: all 0.4s ease;
	}
	.fs .fs-detail {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}
	.fs .fs-rows {
		display: flex;
		flex-direction: column;
		border-top: 1px solid var(--ui-2);
	}
	.fs .fs-row {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.25rem 0;
		line-height: 1.25;
		border-bottom: 1px solid var(--ui-2);
	}
	.fs .fs-row-name {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.875rem;
		color: var(--tx-2);
	}
	.fs .fs-row-swatch {
		width: 0.7em;
		height: 0.7em;
		border-radius: 2px;
		flex: none;
	}
	.fs .fs-row-val {
		color: var(--tx);
		font-variant-numeric: tabular-nums;
	}
	.fs .fs-row-val span {
		font-size: 0.8125rem;
		color: var(--tx-3);
	}
	@media (max-width: 34rem) {
		.fs .fs-body {
			grid-template-columns: 1fr;
		}
	}
</style>

<script>
	type AxisName = 'Breadth' | 'Depth' | 'Timeline' | 'Evidence';
	type Program = Record<AxisName, number>;
	type Fund = { name: string; programs: Program[] };

	const FUNDS: Fund[] = [
		{
			name: 'Climate Resilience',
			programs: [
				{ Breadth: 2, Depth: 5, Timeline: 5, Evidence: 3 },
				{ Breadth: 5, Depth: 3, Timeline: 1, Evidence: 2 },
				{ Breadth: 4, Depth: 3, Timeline: 2, Evidence: 4 },
			],
		},
		{
			name: 'Refugee Relief',
			programs: [
				{ Breadth: 3, Depth: 5, Timeline: 5, Evidence: 5 },
				{ Breadth: 2, Depth: 4, Timeline: 3, Evidence: 4 },
				{ Breadth: 5, Depth: 2, Timeline: 2, Evidence: 2 },
			],
		},
		{
			name: 'Homelessness',
			programs: [
				{ Breadth: 3, Depth: 5, Timeline: 4, Evidence: 5 },
				{ Breadth: 2, Depth: 5, Timeline: 2, Evidence: 4 },
				{ Breadth: 5, Depth: 2, Timeline: 1, Evidence: 3 },
				{ Breadth: 2, Depth: 4, Timeline: 5, Evidence: 3 },
			],
		},
	];

	const SPATIAL = ['Breadth', 'Depth', 'Timeline'] as const;
	const ROWS: AxisName[] = ['Breadth', 'Depth', 'Timeline', 'Evidence'];
	const COLORS: Record<AxisName, string> = {
		Breadth: 'var(--bl)',
		Depth: 'var(--pu)',
		Timeline: 'var(--or)',
		Evidence: 'var(--cy)',
	};
	const SVGNS = 'http://www.w3.org/2000/svg';
	const R = 84;
	const CX = 170;
	const CY = 112;
	const rad = (d: number) => (d * Math.PI) / 180;

	const DIRS: Record<(typeof SPATIAL)[number], [number, number]> = {
		Breadth: [0, -1],
		Depth: [Math.cos(rad(30)), 0.5],
		Timeline: [-Math.cos(rad(30)), 0.5],
	};
	const PERP: Record<(typeof SPATIAL)[number], [number, number]> = {
		Breadth: [1, 0],
		Depth: [-0.5, Math.sin(rad(60))],
		Timeline: [0.5, Math.sin(rad(60))],
	};

	function point(
		axis: (typeof SPATIAL)[number],
		value: number,
		jitter = 0,
	): [number, number] {
		const [dx, dy] = DIRS[axis];
		const [px, py] = PERP[axis];
		const r = (R * value) / 5;
		return [CX + dx * r + px * jitter, CY + dy * r + py * jitter];
	}

	const mean = (ns: number[]) => ns.reduce((s, n) => s + n, 0) / ns.length;
	const fmt = (p: [number, number]) => `${p[0].toFixed(1)},${p[1].toFixed(1)}`;

	function el<K extends keyof SVGElementTagNameMap>(
		name: K,
		attrs: Record<string, string | number>,
	): SVGElementTagNameMap[K] {
		const node = document.createElementNS(SVGNS, name);
		for (const [k, v] of Object.entries(attrs)) node.setAttribute(k, String(v));
		return node;
	}

	function averages(fund: Fund): Record<AxisName, number> {
		const axis = (a: AxisName) => mean(fund.programs.map((p) => p[a]));
		return {
			Breadth: axis('Breadth'),
			Depth: axis('Depth'),
			Timeline: axis('Timeline'),
			Evidence: axis('Evidence'),
		};
	}

	function initFundShape(root: HTMLElement, index: number) {
		const tabsEl = root.querySelector<HTMLElement>('[data-tabs]')!;
		const svg = root.querySelector<SVGSVGElement>('[data-viz]')!;
		const rowsEl = root.querySelector<HTMLElement>('[data-rows]')!;
		const gradId = `fs-grad-${index}`;
		let active = 0;

		// Gradient blending the three axis tints, used to fill the plotted shape.
		const grad = el('linearGradient', {
			id: gradId,
			x1: 0.2,
			y1: 0,
			x2: 0.8,
			y2: 1,
		});
		(
			[
				[0, COLORS.Breadth],
				[0.5, COLORS.Depth],
				[1, COLORS.Timeline],
			] as const
		).forEach(([offset, color]) => {
			grad.appendChild(el('stop', { offset, 'stop-color': color }));
		});
		const defs = el('defs', {});
		defs.appendChild(grad);
		svg.appendChild(defs);

		FUNDS.forEach((f, i) => {
			const btn = document.createElement('button');
			btn.type = 'button';
			btn.className = 'fs-tab';
			btn.textContent = f.name;
			btn.setAttribute('role', 'tab');
			btn.setAttribute('aria-selected', String(i === active));
			btn.addEventListener('click', () => {
				active = i;
				update();
			});
			tabsEl.appendChild(btn);
		});

		// Static scaffold: grid rings, spokes, axis labels.
		for (let lvl = 1; lvl <= 5; lvl++) {
			svg.appendChild(
				el('polygon', {
					points: SPATIAL.map((a) => fmt(point(a, lvl))).join(' '),
					fill: 'none',
					stroke: 'var(--ui-2)',
					'stroke-width': lvl === 5 ? 1.25 : 1,
				}),
			);
		}
		for (const a of SPATIAL) {
			const [ex, ey] = point(a, 5);
			svg.appendChild(
				el('line', {
					x1: CX,
					y1: CY,
					x2: ex.toFixed(1),
					y2: ey.toFixed(1),
					stroke: COLORS[a],
					'stroke-opacity': 0.5,
					'stroke-width': 1,
				}),
			);
		}
		const labels: [(typeof SPATIAL)[number], number, number, string][] = [
			['Breadth', CX, CY - R - 12, 'middle'],
			['Depth', point('Depth', 5)[0] + 8, point('Depth', 5)[1] + 14, 'start'],
			['Timeline', point('Timeline', 5)[0] - 8, point('Timeline', 5)[1] + 14, 'end'],
		];
		for (const [text, x, y, anchor] of labels) {
			const t = el('text', {
				x: x.toFixed(1),
				y: y.toFixed(1),
				'text-anchor': anchor,
				style: `font-family:var(--font-sans);font-size:12px;fill:${COLORS[text]};`,
			});
			t.textContent = text;
			svg.appendChild(t);
		}

		const dyn = el('g', {});
		svg.appendChild(dyn);

		const rowValues = ROWS.map((name) => {
			const row = document.createElement('div');
			row.className = 'fs-row';
			row.innerHTML = `
				<span class="fs-row-name"><span class="fs-row-swatch" style="background:${COLORS[name]}"></span>${name}</span>
				<span class="fs-row-val" data-val></span>`;
			rowsEl.appendChild(row);
			return row.querySelector<HTMLElement>('[data-val]')!;
		});

		function update() {
			const fund = FUNDS[active];
			const avg = averages(fund);

			tabsEl
				.querySelectorAll<HTMLElement>('.fs-tab')
				.forEach((t, i) => t.setAttribute('aria-selected', String(i === active)));

			dyn.replaceChildren();

			fund.programs.forEach((prog, i) => {
				const jitter = (i - (fund.programs.length - 1) / 2) * 5;
				for (const a of SPATIAL) {
					const [x, y] = point(a, prog[a], jitter);
					dyn.appendChild(
						el('circle', {
							class: 'fs-dot',
							cx: x.toFixed(1),
							cy: y.toFixed(1),
							r: 2.5,
							fill: 'var(--tx-3)',
							'fill-opacity': 0.5,
						}),
					);
				}
			});

			const verts = SPATIAL.map((a) => point(a, avg[a]));
			dyn.appendChild(
				el('polygon', {
					class: 'fs-poly',
					points: verts.map(fmt).join(' '),
					fill: `url(#${gradId})`,
					'fill-opacity': (0.2 + ((avg.Evidence - 1) / 4) * 0.5).toFixed(3),
					stroke: 'var(--cy)',
					'stroke-width': 2.5,
					'stroke-linejoin': 'round',
				}),
			);
			verts.forEach((v, i) =>
				dyn.appendChild(
					el('circle', {
						class: 'fs-vert',
						cx: v[0].toFixed(1),
						cy: v[1].toFixed(1),
						r: 4,
						fill: COLORS[SPATIAL[i]],
						stroke: 'var(--bg)',
						'stroke-width': 1.5,
					}),
				),
			);

			const n = fund.programs.length;
			ROWS.forEach((name, i) => {
				rowValues[i].innerHTML = `${avg[name].toFixed(1)} <span>/ 5</span>`;
			});
			svg.setAttribute(
				'aria-label',
				`Impact shape of ${fund.name}: ${n} programs, breadth ${avg.Breadth.toFixed(1)}, depth ${avg.Depth.toFixed(1)}, timeline ${avg.Timeline.toFixed(1)}, evidence ${avg.Evidence.toFixed(1)} out of 5.`,
			);
		}

		update();
	}

	document
		.querySelectorAll<HTMLElement>('[data-fundshape]')
		.forEach((root, i) => initFundShape(root, i));
</script>
