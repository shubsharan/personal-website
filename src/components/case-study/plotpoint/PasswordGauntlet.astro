---
// The Touring Test, Level 1 — creating an account, rebuilt to actually play.
// Satisfy one password rule and a worse one appears; clear them all and the
// Terms & Conditions become the final boss. Pure vanilla TS in the <script>.
---

<div
	class="pg font-sans text-tx"
	data-gauntlet
	role="group"
	aria-label="Create your account"
>
	<p class="label text-cy">Kempelen Labs · Field Debugger</p>
	<h3 class="mt-2 font-serif text-2xl text-tx">Create your account</h3>
	<p class="mt-1 text-sm text-tx-2">
		Choose a secure password. We take security very seriously.
	</p>

	<input
		type="text"
		autocomplete="off"
		autocapitalize="off"
		spellcheck="false"
		data-pw
		class="pg-input mt-4"
		placeholder="Type a password…"
		aria-label="Password"
	/>

	<ul class="pg-rules mt-4" data-rules></ul>

	<div class="pg-terms mt-4" data-terms hidden>
		<div class="pg-terms-box" data-terms-box tabindex="0">
			<p class="pg-terms-title">Terms &amp; Conditions</p>
			<div data-terms-text></div>
			<p class="pg-terms-end" data-terms-end>
				— End of agreement. You actually read all that. We're a little worried
				about you.
			</p>
		</div>
		<label class="pg-agree" data-agree-label>
			<input type="checkbox" data-agree disabled />
			<span>I have read and agree to all 40,000 words.</span>
		</label>
	</div>

	<button type="button" class="pg-submit mt-4" data-submit disabled>
		Create account
	</button>

	<div class="pg-success mt-4" data-success hidden>
		<p class="pg-success-title">You're in. Welcome, debugger.</p>
		<p class="mt-1 text-sm text-tx-2">
			MIRA goes live in 4 hours. Head into the park and find the first server
			node.
		</p>
	</div>
</div>

<style is:global>
	/* Global (nested under .pg) so styles reach the rule rows and terms the client
	   script creates — Astro's scoped styles only attach to template elements. */
	.pg {
		max-width: 100%;
	}
	.pg .pg-input {
		width: 100%;
		padding: 0.625rem 0.75rem;
		font-family: var(--font-sans);
		font-size: 0.9375rem;
		color: var(--tx);
		background: var(--bg);
		border: 1px solid var(--ui-3);
		border-radius: 8px;
		outline: none;
		transition: border-color 0.15s ease;
	}
	.pg .pg-input:focus {
		border-color: var(--accent);
	}
	.pg .pg-rules {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		list-style: none;
		padding: 0;
		margin-top: 1rem;
	}
	.pg .pg-rule {
		display: flex;
		align-items: flex-start;
		gap: 0.5rem;
		font-size: 0.8125rem;
		line-height: 1.4;
		color: var(--tx-2);
		animation: pg-in 0.25s ease;
	}
	.pg .pg-rule[data-met='true'] {
		color: var(--tx-3);
		text-decoration: line-through;
		text-decoration-color: var(--ui-3);
	}
	.pg .pg-tick {
		flex: none;
		width: 1rem;
		height: 1rem;
		margin-top: 0.05rem;
		border-radius: 50%;
		border: 1px solid var(--ui-3);
		display: grid;
		place-items: center;
		font-size: 0.625rem;
		line-height: 1;
		color: transparent;
	}
	.pg .pg-rule[data-met='true'] .pg-tick {
		background: var(--accent);
		border-color: var(--accent);
		color: var(--bg);
	}
	.pg .pg-count {
		font-variant-numeric: tabular-nums;
		color: var(--cy);
	}
	.pg .pg-terms-title {
		font-family: var(--font-serif);
		font-size: 1rem;
		color: var(--tx);
	}
	.pg .pg-terms-box {
		height: 8.5rem;
		overflow-y: auto;
		padding: 0.75rem 0.875rem;
		background: var(--bg);
		border: 1px solid var(--ui-2);
		border-radius: 8px;
		font-size: 0.75rem;
		line-height: 1.5;
		color: var(--tx-2);
	}
	.pg .pg-terms-box p {
		margin: 0 0 0.5rem;
	}
	.pg .pg-terms-end {
		color: var(--tx-3);
		font-style: italic;
	}
	.pg .pg-agree {
		display: flex;
		align-items: flex-start;
		gap: 0.5rem;
		margin-top: 0.625rem;
		font-size: 0.8125rem;
		color: var(--tx-2);
		cursor: pointer;
	}
	.pg .pg-agree input {
		margin-top: 0.15rem;
		accent-color: var(--accent);
	}
	.pg .pg-agree[data-enabled='false'] {
		opacity: 0.5;
		cursor: not-allowed;
	}
	.pg .pg-submit {
		width: 100%;
		padding: 0.625rem 0.75rem;
		font-family: var(--font-sans);
		font-size: 0.875rem;
		font-weight: 600;
		color: var(--bg);
		background: var(--tx);
		border: none;
		border-radius: 999px;
		cursor: pointer;
		transition:
			opacity 0.15s ease,
			transform 0.1s ease;
	}
	.pg .pg-submit:disabled {
		opacity: 0.35;
		cursor: not-allowed;
	}
	.pg .pg-submit:not(:disabled):active {
		transform: translateY(1px);
	}
	.pg .pg-success {
		padding: 0.875rem 1rem;
		background: color-mix(in oklab, var(--cy) 10%, transparent);
		border: 1px solid color-mix(in oklab, var(--cy) 30%, transparent);
		border-radius: 8px;
	}
	.pg .pg-success-title {
		font-family: var(--font-serif);
		font-size: 1.125rem;
		color: var(--tx);
	}
	@keyframes pg-in {
		from {
			opacity: 0;
			transform: translateY(-3px);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}
</style>

<script>
	type Rule = {
		// `label` may fold in live feedback (e.g. the running digit sum) so the
		// numeric rules never feel like they're silently failing.
		label: (v: string) => string;
		test: (v: string) => boolean;
	};

	const digitSum = (v: string) =>
		(v.match(/\d/g) ?? []).reduce((s, d) => s + Number(d), 0);

	const RULES: Rule[] = [
		{ label: () => 'At least 8 characters.', test: (v) => v.length >= 8 },
		{ label: () => 'Include a number.', test: (v) => /\d/.test(v) },
		{ label: () => 'Include a capital letter.', test: (v) => /[A-Z]/.test(v) },
		{
			label: () =>
				'Name an Outside Lands stage (hint: the tower on the hill, “Sutro”).',
			test: (v) => /sutro/i.test(v),
		},
		{
			label: () => 'Prove you touched grass — include the word “grass”.',
			test: (v) => /grass/i.test(v),
		},
		{
			label: () =>
				'Mate in one: White’s queen on h5 can take f7. Enter the move (e.g. Qxf7).',
			test: (v) => /q?x?f7/i.test(v),
		},
		{
			// Last on purpose: by now the chess move’s “7” is baked into your
			// password, so the live counter is the only fair way to hit 15.
			label: (v) =>
				`Your digits must add up to exactly 15 <span class="pg-count">(you’re at ${digitSum(v)})</span>.`,
			test: (v) => digitSum(v) === 15,
		},
	];

	const TERMS = [
		'By creating an account you agree to debug MIRA in good faith, to not fall in love with her, and to hold Kempelen Labs harmless for any existential dread incurred during the festival.',
		'You agree that a popstar is a person, legally, spiritually, and for tax purposes, even when she is a large language model wearing sunglasses.',
		'The following is the entire script of the Bee Movie, reproduced here for reasons our legal team has declined to explain. “According to all known laws of aviation, there is no way a bee should be able to fly…”',
		'Section 12(b): scrolling too fast is a violation of this agreement and, historically, caused the page to freeze. We have graciously disabled that feature for this exhibit.',
		'You agree that the friction is the point, that going outside is good for you, and that the person standing next to you right now is worth the trouble.',
	];

	function initGauntlet(root: HTMLElement) {
		const input = root.querySelector<HTMLInputElement>('[data-pw]')!;
		const rulesEl = root.querySelector<HTMLUListElement>('[data-rules]')!;
		const terms = root.querySelector<HTMLElement>('[data-terms]')!;
		const termsBox = root.querySelector<HTMLElement>('[data-terms-box]')!;
		const termsText = root.querySelector<HTMLElement>('[data-terms-text]')!;
		const agreeLabel = root.querySelector<HTMLElement>('[data-agree-label]')!;
		const agree = root.querySelector<HTMLInputElement>('[data-agree]')!;
		const submit = root.querySelector<HTMLButtonElement>('[data-submit]')!;
		const success = root.querySelector<HTMLElement>('[data-success]')!;

		// Repeat the terms so there's a real scroll to fight through.
		termsText.innerHTML = Array.from({ length: 3 })
			.flatMap(() => TERMS)
			.map((t) => `<p>${t}</p>`)
			.join('');

		// How many rules are "unlocked". Starts at 1; each cleared rule reveals
		// the next, so a satisfied requirement summons a worse one.
		let revealed = 1;

		function render() {
			const value = input.value;
			const results = RULES.map((r) => r.test(value));

			// Reveal the next rule once every visible rule passes.
			while (
				revealed < RULES.length &&
				results.slice(0, revealed).every(Boolean)
			) {
				revealed++;
			}

			rulesEl.innerHTML = '';
			for (let i = 0; i < revealed; i++) {
				const met = results[i];
				const li = document.createElement('li');
				li.className = 'pg-rule';
				li.dataset.met = String(met);
				li.innerHTML = `<span class="pg-tick" aria-hidden="true">✓</span><span>${RULES[i].label(value)}</span>`;
				rulesEl.appendChild(li);
			}

			const allRulesMet = results.every(Boolean);
			terms.hidden = !allRulesMet;

			const agreed = allRulesMet && agree.checked;
			submit.disabled = !agreed;
		}

		// The agree checkbox only unlocks once you've scrolled to the bottom.
		function checkScroll() {
			const atBottom =
				termsBox.scrollTop + termsBox.clientHeight >= termsBox.scrollHeight - 4;
			agree.disabled = !atBottom;
			agreeLabel.dataset.enabled = String(atBottom);
		}

		input.addEventListener('input', render);
		termsBox.addEventListener('scroll', checkScroll);
		agree.addEventListener('change', render);
		submit.addEventListener('click', () => {
			success.hidden = false;
			submit.disabled = true;
			submit.textContent = 'Account created';
		});

		agreeLabel.dataset.enabled = 'false';
		render();
	}

	document
		.querySelectorAll<HTMLElement>('[data-gauntlet]')
		.forEach(initGauntlet);
</script>
