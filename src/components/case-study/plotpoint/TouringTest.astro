---
// The five levels of The Touring Test, each with its real in-app screenshot from
// the launch write-up. Pick a level to see the actual screen and what it asked of
// players. Static template (images + tabs all present), so scoped styles apply;
// the script only toggles which shot is visible and swaps the caption.
const LEVELS = [
	{
		name: 'Password',
		img: '/plotpoint/level-1-password.jpg',
		alt: 'The Create Password screen and its escalating list of validation rules, ending in a chess puzzle.',
		desc: 'Create an account — if you can. Every rule you clear summons a worse one: Outside Lands trivia, arithmetic, even a chess puzzle. Only 33.8% of players made it past this level.',
	},
	{
		name: 'Debug',
		img: '/plotpoint/level-2-debug.jpg',
		alt: 'MIRA, the AI popstar, with a Debug Module and a Debug Setlist prompt asking for an artist name.',
		desc: 'MIRA is hallucinating. Name the headliner she plagiarized, then spot the “impossible” tour date on the setlist that gives the fraud away.',
	},
	{
		name: 'Servers',
		img: '/plotpoint/level-3-servers.jpg',
		alt: 'A Server Nodes screen listing Alpha, Beta and Gamma servers to unlock by scanning NFC tags.',
		desc: 'Walk the park and scan NFC tags hidden at real food vendors — Reem’s, Brenda’s, Fowl + Fare — to bring MIRA’s server nodes online.',
	},
	{
		name: 'Teamwork',
		img: '/plotpoint/level-4-teamwork.jpg',
		alt: 'A scrambled morse-code message and a QR code screen for adding three friends to a team.',
		desc: 'The final transmission is split across players. Add three friends, each holding a fragment, and unscramble it together.',
	},
	{
		name: 'The End',
		img: '/plotpoint/level-5-the-end.jpg',
		alt: 'An inbox from MIRA and Kempelen Labs, and a badges page including a “Mechanical Turk” badge.',
		desc: 'Internal Slack logs reveal the truth: MIRA was never an AI — just a team of humans behind the curtain. The Mechanical Turk, reborn as a startup.',
	},
];
---

<div class="tt font-sans" data-tt>
	<p class="label text-tx-3">The Touring Test · five levels</p>

	<div class="tt-tabs mt-3" role="tablist" aria-label="Levels">
		{
			LEVELS.map((lvl, i) => (
				<button
					type="button"
					class="tt-tab"
					role="tab"
					data-level={i}
					data-desc={lvl.desc}
					aria-selected={i === 0 ? 'true' : 'false'}
				>
					<span class="tt-num">{i + 1}</span>
					{lvl.name}
				</button>
			))
		}
	</div>

	<div class="tt-stage mt-4">
		{
			LEVELS.map((lvl, i) => (
				<img
					class="tt-shot"
					src={lvl.img}
					alt={lvl.alt}
					data-level={i}
					decoding="async"
					hidden={i !== 0}
				/>
			))
		}
	</div>

	<p class="tt-desc mt-4" data-caption>{LEVELS[0].desc}</p>
</div>

<style>
	.tt {
		max-width: 100%;
	}
	.tt-tabs {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	.tt-tab {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-family: var(--font-sans);
		font-size: 0.8125rem;
		font-weight: 500;
		padding: 0.375rem 0.75rem;
		color: var(--tx-2);
		background: var(--bg);
		border: 1px solid var(--ui-2);
		border-radius: 999px;
		cursor: pointer;
		transition:
			color 0.15s ease,
			border-color 0.15s ease,
			background 0.15s ease;
	}
	.tt-tab:hover {
		color: var(--tx);
		border-color: var(--ui-3);
	}
	.tt-num {
		font-variant-numeric: tabular-nums;
		color: var(--tx-3);
	}
	.tt-tab[aria-selected='true'] {
		color: var(--bg);
		background: var(--tx);
		border-color: var(--tx);
	}
	.tt-tab[aria-selected='true'] .tt-num {
		color: color-mix(in oklab, var(--bg) 60%, transparent);
	}
	.tt-stage {
		border: 1px solid var(--ui-2);
		border-radius: 12px;
		overflow: hidden;
		background: var(--bg-2);
	}
	.tt-shot {
		display: block;
		width: 100%;
		height: auto;
	}
	.tt-desc {
		font-size: 0.875rem;
		line-height: 1.55;
		color: var(--tx-2);
		min-height: 3.4em;
	}
</style>

<script>
	document.querySelectorAll<HTMLElement>('[data-tt]').forEach((root) => {
		const tabs = root.querySelectorAll<HTMLButtonElement>('.tt-tab');
		const shots = root.querySelectorAll<HTMLImageElement>('.tt-shot');
		const desc = root.querySelector<HTMLElement>('[data-caption]')!;
		tabs.forEach((tab) => {
			tab.addEventListener('click', () => {
				const i = Number(tab.dataset.level);
				tabs.forEach((t) =>
					t.setAttribute('aria-selected', String(t === tab)),
				);
				shots.forEach((s) => (s.hidden = Number(s.dataset.level) !== i));
				desc.textContent = tab.dataset.desc ?? '';
			});
		});
	});
</script>
