---
// Escape the reading column for one block (a demo, an image, a wide table).
// `size` picks how far: 'wide' (default) nudges past the text measure; 'full'
// goes near-viewport. Prose around it is untouched. See `.breakout` in global.css.
interface Props {
	size?: 'wide' | 'full';
	class?: string;
}

const { size = 'wide', class: className } = Astro.props;
const classes = ['breakout', size === 'full' && 'breakout-full', className]
	.filter(Boolean)
	.join(' ');
---

<div class={classes}>
	<slot />
</div>
