---
/*
 * The Apollo 13 "everything on the table" scene as animated ASCII — a silent,
 * colored band above the hero, with a settings bar to reshape it live.
 *
 * Frames are pre-rendered offline (scripts/ascii-encode.mjs --color) into
 * apollo-ascii*.json. Each cell is ONE packed char encoding a brightness level
 * (0..15) and a Flexoki palette bucket (0..3) — see PACK_ALPHABET. Because we
 * store the level (not a baked glyph), the browser can re-map the ASCII ramp,
 * contrast, invert, and color live without the source video. Only resolution
 * is a true pre-baked variant (coarse/default/fine), loaded on demand.
 *
 * Decorative + accessible: role="img" with a label, a static poster frame for
 * no-JS / reduced-motion, and controls that are just enhancement.
 *
 * The client behavior lives in ./ascii/* (composed by scene.ts) and the shared,
 * framework-agnostic bits in ../utils/ascii-{config,frames,carve}.mjs.
 */
import AsciiControls from './AsciiControls.astro';
import data from '../assets/apollo-ascii-fine.json';
import { POSTER_RAMP } from '../utils/ascii-config.mjs';
import { buildLut, densestFrame, posterText } from '../utils/ascii-frames.mjs';

const cols: number = data.cols;
const rows: number = data.rows;

/* Poster (no-JS / reduced-motion still): densest frame, default ramp applied. */
const lut = buildLut(data.pack);
const poster = densestFrame(data.frames as string[], lut);
const posterLines = posterText(poster, { cols, rows, lut, ramp: POSTER_RAMP });
---

<figure
	class="rise w-full"
	style="animation-delay: 40ms"
	data-ascii-frame
>
	{/* Positioning + inline-size container so the heading can overlay the stage exactly and size itself to the band (cqi below). */}
	<div class="relative [container-type:inline-size]">
		<div
			class="relative aspect-[64/27] overflow-hidden border-y border-ui bg-[radial-gradient(circle_at_50%_45%,var(--bg-2),var(--bg)_72%)]"
			role="img"
			aria-label="Engineers spread improvised materials across a workbench, rendered as animated ASCII art."
		>
			<pre
				class="absolute inset-0 m-0 box-border h-full w-full overflow-hidden whitespace-pre py-[0.4rem] font-mono text-[clamp(0.3rem,1.1vw,0.6rem)] font-normal leading-none text-tx-2"
				data-ascii-fallback
				aria-hidden="true">{posterLines}</pre>
			<canvas
				class="absolute inset-0 block h-full w-full opacity-0 transition-opacity duration-[180ms] [&.is-ready]:opacity-100 motion-reduce:transition-none"
				data-ascii-canvas
				aria-hidden="true"></canvas>
		</div>
		{/*
		 * The heading the ASCII parts around. Real text: accessible, indexable,
		 * and visible without JS. Sized to the band (cqi) and always one line.
		 * The script carves that single line and adds `.is-carved` once the grid
		 * is masked, which drops the legibility scrim.
		 */}
		<h2
			class="pointer-events-none absolute left-1/2 top-1/2 m-0 w-[90%] -translate-x-1/2 -translate-y-1/2 p-0 text-center text-[clamp(2.5rem,4cqi,16rem)] leading-[1.05] text-balance text-tx [&:not(.is-carved)]:[text-shadow:0_0_0.6em_var(--bg),0_0_1.2em_var(--bg)]"
			data-ascii-title>EVERYTHING ON THE TABLE</h2>
	</div>

	<AsciiControls />
</figure>

<script>
	import { createAsciiScene } from './ascii/scene';
	import { loadDefault, VARIANTS } from './ascii/framesets';

	document
		.querySelectorAll<HTMLElement>('[data-ascii-frame]')
		.forEach((root) => createAsciiScene(root, { loadDefault, variants: VARIANTS }));
</script>
