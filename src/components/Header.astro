---
import { NAV, SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav class="font-sans shell flex items-baseline justify-between gap-8 py-4">
		<!-- The wordmark is the home link; a separate "Home" item would be noise. -->
		<a
			href="/"
			class="text-[1.15rem] leading-none text-tx no-underline"
		>
			{SITE_TITLE}
		</a>
		<div class="flex items-baseline gap-6">
			{NAV.map((item) => <HeaderLink href={item.href}>{item.label}</HeaderLink>)}
		</div>
	</nav>
</header>
