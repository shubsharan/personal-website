---
interface Props {
  href?: string;
  rail: string;
  label: string;
  title: string;
  description: string;
}

const { href, rail, label, title, description } = Astro.props;
const Tag = href ? "a" : "div";
---

<li>
  <Tag
    href={href}
    class:list={[
      "grid grid-cols-1 gap-y-2 py-8 text-tx no-underline sm:grid-cols-row",
      href && "group transition-colors hover:text-accent",
    ]}
  >
    <span
      class:list={[
        "row-start-2 pr-2 font-mono text-xs tracking-wide text-tx-3 tabular-nums sm:row-start-1",
        href && "transition-colors group-hover:text-accent",
      ]}
    >
      {rail}
    </span>
    <span class="flex min-w-0 flex-col gap-2">
      <span
        class:list={[
          "font-mono text-xs tracking-wide text-tx-3 tabular-nums",
          href && "transition-colors group-hover:text-accent",
        ]}
      >
        {label}
      </span>
      <h2>{title}</h2>
      <p>{description}</p>
    </span>
  </Tag>
</li>
