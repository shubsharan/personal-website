---

import { Icon } from 'astro-icon/components';

const iconSize = 14;

const optionClass =
	'relative z-1 inline-flex items-center justify-center rounded-full border-0 bg-transparent p-1.5 text-tx-2';
---

<div
	class="relative inline-flex rounded-full border border-ui bg-2 p-0.5"
	role="radiogroup"
	aria-label="Theme"
	data-theme-toggle
>
	<span class="pointer-events-none absolute inset-0.5 flex" aria-hidden="true">
		<span
			class:list={[
				'w-1/2 rounded-full bg-bg-2',
				'translate-x-full transition-transform duration-200 ease-in-out motion-reduce:transition-none',
				'[:root[data-theme=light]_&]:translate-x-0',
				'[:root[data-theme=dark]_&]:translate-x-full',
				'[@media(prefers-color-scheme:light)]:[:root:not([data-theme])_&]:translate-x-0',
			]}
		></span>
	</span>
	<button
		type="button"
		role="radio"
		aria-label="Light"
		aria-checked="false"
		data-theme-option="light"
		tabindex="-1"
		class:list={[
			optionClass,
			'[:root[data-theme=light]_&]:text-tx',
			'[@media(prefers-color-scheme:light)]:[:root:not([data-theme])_&]:text-tx',
		]}
	>
		<Icon name="lucide:sun" width={iconSize} height={iconSize} aria-hidden="true" />
	</button>
	<button
		type="button"
		role="radio"
		aria-label="Dark"
		aria-checked="true"
		data-theme-option="dark"
		tabindex="0"
		class:list={[
			optionClass,
			'[:root[data-theme=dark]_&]:text-tx',
			'[@media(prefers-color-scheme:dark)]:[:root:not([data-theme])_&]:text-tx',
		]}
	>
		<Icon name="lucide:moon" width={iconSize} height={iconSize} aria-hidden="true" />
	</button>
</div>

<script>
	const root = document.querySelector<HTMLElement>('[data-theme-toggle]');
	const options = root
		? Array.from(root.querySelectorAll<HTMLButtonElement>('[data-theme-option]'))
		: [];
	const systemDark = window.matchMedia('(prefers-color-scheme: dark)');

	function isDark() {
		const t = document.documentElement.getAttribute('data-theme');
		if (t === 'light') return false;
		if (t === 'dark') return true;
		return systemDark.matches;
	}

	function currentTheme(): 'light' | 'dark' {
		return isDark() ? 'dark' : 'light';
	}

	function sync() {
		const theme = currentTheme();
		for (const opt of options) {
			const on = opt.dataset.themeOption === theme;
			opt.setAttribute('aria-checked', String(on));
			opt.tabIndex = on ? 0 : -1;
		}
	}

	function setTheme(theme: 'light' | 'dark') {
		document.documentElement.setAttribute('data-theme', theme);
		localStorage.setItem('theme', theme);
		sync();
	}

	sync();
	systemDark.addEventListener('change', sync);

	root?.addEventListener('click', (e) => {
		const btn = (e.target as Element | null)?.closest<HTMLButtonElement>('[data-theme-option]');
		if (!btn || !root.contains(btn)) return;
		const theme = btn.dataset.themeOption;
		if (theme === 'light' || theme === 'dark') setTheme(theme);
	});

	root?.addEventListener('keydown', (e) => {
		const keys = ['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown'];
		if (!keys.includes(e.key)) return;
		e.preventDefault();
		const next = currentTheme() === 'light' ? 'dark' : 'light';
		setTheme(next);
		options.find((o) => o.dataset.themeOption === next)?.focus();
	});
</script>
