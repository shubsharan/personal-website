---
import { Icon } from 'astro-icon/components';
import { NAV } from '../../consts';
import HeaderLink from './HeaderLink.astro';
import ThemeToggle from './ThemeToggle.astro';

const iconSize = 20;
---

<header class="w-full border-b border-ui" data-site-header>
	<nav class="font-sans container max-w-3xl flex items-center justify-between gap-8 py-4">
		<a
			href="/"
			class="flex flex-row items-center gap-1.5 leading-none text-tx no-underline"
		>
			<img
				src="/logo.svg"
				alt=""
				width="18"
				height="24"
				class="h-6 w-auto"
			/>
			<span class="font-logo text-3xl text-tx mt-0.5">shub</span>
		</a>

		<div class="hidden md:flex items-center gap-6">
			{NAV.map((item) => <HeaderLink href={item.href}>{item.label}</HeaderLink>)}
			<ThemeToggle />
		</div>

		<button
			type="button"
			class="md:hidden inline-flex items-center justify-center rounded-sm text-tx-2 hover:text-tx"
			aria-label="Open menu"
			aria-expanded="false"
			aria-controls="mobile-nav"
			data-mobile-nav-open
		>
			<Icon name="lucide:menu" width={iconSize} height={iconSize} aria-hidden="true" />
		</button>
	</nav>

	<dialog
		id="mobile-nav"
		class="m-0 max-h-none max-w-none h-dvh w-full border-0 bg-bg p-0 text-tx backdrop:bg-bg open:flex open:flex-col md:hidden"
		data-mobile-nav
	>
		<div
			class="font-sans container max-w-3xl flex items-center justify-between gap-8 border-b border-ui py-4"
		>
			<a
				href="/"
				class="flex flex-row items-center gap-1.5 leading-none text-tx no-underline"
				data-mobile-nav-close
			>
				<img
					src="/logo.svg"
					alt=""
					width="18"
					height="24"
					class="h-6 w-auto"
				/>
				<span class="font-logo text-3xl text-tx">shub</span>
			</a>
			<button
				type="button"
				class="inline-flex items-center justify-center rounded-sm text-tx-2 hover:text-tx"
				aria-label="Close menu"
				autofocus
				data-mobile-nav-close
			>
				<Icon name="lucide:x" width={iconSize} height={iconSize} aria-hidden="true" />
			</button>
		</div>

		<div class="font-sans container max-w-3xl flex flex-1 flex-col gap-8 py-10">
			<ul class="flex flex-col gap-6">
				{
					NAV.map((item) => (
						<li>
							<HeaderLink
								href={item.href}
								class="text-2xl normal-case tracking-normal"
								data-mobile-nav-close
							>
								{item.label}
							</HeaderLink>
						</li>
					))
				}
			</ul>
			<div class="mt-auto pb-4">
				<ThemeToggle />
			</div>
		</div>
	</dialog>
</header>

<script>
	const header = document.querySelector<HTMLElement>('[data-site-header]');
	const dialog = header?.querySelector<HTMLDialogElement>('[data-mobile-nav]');
	const openBtn = header?.querySelector<HTMLButtonElement>('[data-mobile-nav-open]');

	function setExpanded(open: boolean) {
		openBtn?.setAttribute('aria-expanded', String(open));
	}

	function openNav() {
		if (!dialog || dialog.open) return;
		dialog.showModal();
		setExpanded(true);
	}

	function closeNav() {
		if (!dialog?.open) return;
		dialog.close();
		setExpanded(false);
	}

	openBtn?.addEventListener('click', openNav);

	header?.addEventListener('click', (e) => {
		const target = (e.target as Element | null)?.closest<HTMLElement>('[data-mobile-nav-close]');
		if (!target || !dialog?.contains(target)) return;
		closeNav();
	});

	dialog?.addEventListener('close', () => setExpanded(false));

	window.matchMedia('(min-width: 768px)').addEventListener('change', (e) => {
		if (e.matches) closeNav();
	});
</script>
