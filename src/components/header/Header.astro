---
import { Icon } from "astro-icon/components";
import { NAV } from "../../consts";
import HeaderLink from "./HeaderLink.astro";

const iconSize = 20;
---

<div
  class='flex items-center justify-between gap-4 pt-6 pb-8 md:hidden'
  data-site-header
>
  <a href='/' class='flex h-5 items-center gap-1.5 leading-none no-underline'>
    <img src='/logo.svg' alt='' width='18' height='24' class='h-5 w-auto' />
  </a>
  <button
    type='button'
    class='inline-flex items-center justify-center rounded-sm text-muted-foreground hover:text-foreground'
    aria-label='Open menu'
    aria-expanded='false'
    aria-controls='mobile-nav'
    data-mobile-nav-open
  >
    <Icon
      name='lucide:menu'
      width={iconSize}
      height={iconSize}
      aria-hidden='true'
    />
  </button>
</div>

<aside
  class='sticky top-0 hidden h-dvh flex-col gap-4 self-start pt-36 md:col-span-3 md:col-start-1 md:row-start-1 md:flex'
  aria-label='Site'
>
  <a
    href='/'
    class='flex h-5 items-center gap-2 self-start leading-none no-underline'
  >
    <img src='/logo.svg' alt='' class='aspect-[3/4] size-6' />
  </a>
  <nav class='flex flex-col gap-1 items-start' aria-label='Primary'>
    {NAV.map((item) => <HeaderLink href={item.href}>{item.label}</HeaderLink>)}
  </nav>
</aside>

<dialog
  id='mobile-nav'
  class='m-0 h-dvh max-h-none w-full max-w-none border-0 bg-background p-0 backdrop:bg-background open:flex open:flex-col md:hidden'
  data-mobile-nav
>
  <div class='flex items-center justify-between gap-4 px-4 pt-6 pb-8'>
    <a
      href='/'
      class='flex h-5 items-center gap-1.5 leading-none no-underline'
      data-mobile-nav-close
    >
      <img src='/logo.svg' alt='' width='18' height='24' class='h-5 w-auto' />
    </a>
    <button
      type='button'
      class='inline-flex items-center justify-center rounded-sm'
      aria-label='Close menu'
      autofocus
      data-mobile-nav-close
    >
      <Icon
        name='lucide:x'
        width={iconSize}
        height={iconSize}
        aria-hidden='true'
      />
    </button>
  </div>

  <nav
    class='flex flex-1 flex-col items-start gap-6 px-4 pt-4'
    aria-label='Primary'
  >
    {
      NAV.map((item) => (
        <HeaderLink href={item.href} class='text-2xl' data-mobile-nav-close>
          {item.label}
        </HeaderLink>
      ))
    }
  </nav>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("[data-mobile-nav]");
  const openBtn = document.querySelector<HTMLButtonElement>(
    "[data-mobile-nav-open]",
  );

  function setExpanded(open: boolean) {
    openBtn?.setAttribute("aria-expanded", String(open));
  }

  function openNav() {
    if (!dialog || dialog.open) return;
    dialog.showModal();
    setExpanded(true);
  }

  function closeNav() {
    if (!dialog?.open) return;
    dialog.close();
    setExpanded(false);
  }

  openBtn?.addEventListener("click", openNav);

  document.addEventListener("click", (e) => {
    const target = (e.target as Element | null)?.closest<HTMLElement>(
      "[data-mobile-nav-close]",
    );
    if (!target || !dialog?.contains(target)) return;
    closeNav();
  });

  dialog?.addEventListener("close", () => setExpanded(false));

  window.matchMedia("(min-width: 768px)").addEventListener("change", (e) => {
    if (e.matches) closeNav();
  });
</script>
