---
/*
 * The ASCII scene's settings bar: the film credit (a link to the source clip)
 * on the left, and a right-aligned toolbar of grouped icon toggles (detail,
 * color, style, contrast, speed, invert) separated by vertical dividers.
 * Presentational only — the behaviour lives in the scene composed by
 * ./ascii/scene.ts, which finds the toolbar and its buttons by their data-*
 * hooks and wires them to the renderer. The toolbar is hidden until that script
 * enables it, so the interactive icons never show without JS; the credit link
 * always shows.
 *
 * The color and style groups are generated from the SAME definitions the script
 * wires (COLORS / RAMP_ORDER in ../utils/ascii-config.mjs), and their initial
 * pressed state comes from DEFAULTS — so the highlighted control can never drift
 * from what actually renders.
 *
 * Styled with Tailwind utilities. Buttons inherit the bar's tracked-out label
 * type via Preflight; each toggle dims by default (text-tx-3) and lights on
 * hover / when active (aria-pressed). Repeated patterns are hoisted to consts.
 */
import { COLORS, DEFAULTS, RAMP_ORDER } from '../utils/ascii-config.mjs';

// Base reset shared by every toggle; most also dim -> lit on hover / active.
const btn = 'cursor-pointer border-0 bg-transparent p-0 transition-colors';
const toggle = `${btn} text-tx-3 hover:text-tx aria-pressed:text-tx`;
// A ramp toggle shows a few sample glyphs of its style, in mono.
const rampBtn = `${toggle} font-mono text-[0.8em] normal-case tracking-[0.05em]`;

// Color swatch: a hued dot (::before); the selected one gains a ring.
const swatch = `${btn} leading-[0] before:block before:h-[9px] before:w-[9px] before:rounded-full before:opacity-65 before:content-[''] before:[transition:opacity_0.15s_ease,box-shadow_0.15s_ease] hover:before:opacity-100 aria-pressed:before:opacity-100 aria-pressed:before:shadow-[0_0_0_1px_var(--bg),0_0_0_2px_var(--tx)]`;

// A control group (buttons cluster tightly) and the rule that divides groups.
const group = 'inline-flex items-center gap-[0.4rem]';
const divider = 'h-[0.95em] w-px flex-none bg-ui-3';
---

<div
	class="label mt-[0.7rem] flex flex-wrap items-center justify-between gap-x-4 gap-y-[0.4rem] px-6 text-tx-3 max-[40rem]:gap-x-[0.8rem] max-[40rem]:text-[0.625rem]"
>
	<a
		class="whitespace-nowrap text-tx-3 no-underline transition-colors hover:text-tx"
		href="https://www.youtube.com/watch?v=ry55--J4_VQ&t=38s"
		target="_blank"
		rel="noreferrer">[src]</a>

	<div
		class="flex flex-wrap items-center gap-x-[0.8rem] gap-y-[0.3rem]"
		data-ascii-controls
		hidden
	>
		<span class={group} role="group" aria-label="Detail">
			<button
				type="button"
				class={`${btn} box-border inline-block h-3 w-3 border border-current bg-[radial-gradient(currentColor_40%,transparent_44%)] bg-center align-middle text-tx-2 [background-size:calc(12px/var(--n,2))_calc(12px/var(--n,2))] hover:text-tx`}
				data-detail
				aria-label="Detail"></button>
		</span>

		<span class={divider} aria-hidden="true"></span>

		<span class={group} role="group" aria-label="Color">
			{
				COLORS.map((c) => (
					<button
						type="button"
						class={`${swatch} ${c.dot}`}
						data-color={c.key}
						aria-pressed={c.key === DEFAULTS.color}
						aria-label={c.label}
					/>
				))
			}
		</span>

		<span class={divider} aria-hidden="true"></span>

		<span class="inline-flex items-center gap-[0.5rem]" role="group" aria-label="Style">
			{
				RAMP_ORDER.map((r) => (
					<button type="button" class={rampBtn} data-ramp={r.key} aria-pressed={r.key === DEFAULTS.ramp} aria-label={r.label}>{r.sample}</button>
				))
			}
		</span>

		<span class={divider} aria-hidden="true"></span>

		<span class={group} role="group" aria-label="Contrast">
			<button
				type="button"
				class={`${btn} box-border inline-block h-3 w-3 rounded-full border border-tx-3 align-middle data-[level=0]:bg-[linear-gradient(90deg,var(--tx)_50%,var(--tx-2)_50%)] data-[level=1]:bg-[linear-gradient(90deg,var(--tx)_50%,var(--tx-3)_50%)] data-[level=2]:bg-[linear-gradient(90deg,var(--tx)_50%,var(--bg)_50%)]`}
				data-contrast-cycle
				aria-label="Contrast"></button>
		</span>

		<span class={divider} aria-hidden="true"></span>

		<span class={group} role="group" aria-label="Speed">
			<button type="button" class={`${btn} text-[0.85em] tracking-[-0.15em] text-tx-3 hover:text-tx`} data-speed aria-label="Speed"></button>
		</span>

		<span class={divider} aria-hidden="true"></span>

		<span class={group} role="group" aria-label="Invert">
			<button
				type="button"
				class={`${btn} inline-flex items-center gap-[3px] align-middle text-tx-2 hover:text-tx before:box-border before:h-[9px] before:w-[9px] before:rounded-full before:border before:border-current before:bg-current before:content-[''] after:box-border after:h-[9px] after:w-[9px] after:rounded-full after:border after:border-current after:content-[''] aria-pressed:before:bg-transparent aria-pressed:after:bg-current`}
				data-invert
				aria-pressed="false"
				aria-label="Invert"></button>
		</span>
	</div>
</div>
