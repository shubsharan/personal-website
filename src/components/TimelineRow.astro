---
interface Props {
	rail: string;
	title: string;
	org?: string;
	description: string;
	href?: string;
}

const { rail, title, org, description, href } = Astro.props;
const Tag = href ? 'a' : 'div';
// Linked rows carry the site's persistent soft underline (brightens to accent
// on row hover via `.group:hover .link-underline`); static rows get nothing, so
// link vs. static reads at a glance without hovering.
const titleLink = href ? 'link-underline' : '';
---

<li class="border-t border-ui">
	<Tag
		href={href}
		class="group grid gap-x-8 gap-y-1 py-4 no-underline md:grid-cols-[7rem_1fr]"
	>
		<span class="label text-tx-3 pt-1 max-md:hidden">{rail}</span>
		<span class="block">
			<span class="flex flex-wrap items-baseline gap-x-2 gap-y-0.5">
				<span class={`text-lg font-serif text-tx ${titleLink}`}>
					{title}
				</span>
				{org && <span class="label text-tx-3">{org}</span>}
				<span class="label text-tx-3 md:hidden">· {rail}</span>
			</span>
			<p class="mt-1 text-tx-2">{description}</p>
		</span>
	</Tag>
</li>
