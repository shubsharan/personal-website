---
import { AUTHOR, SOCIALS } from '../consts';

const year = new Date().getFullYear();
---

<footer class="mt-24 w-full border-t border-ui">
	<div class="font-sans container max-w-3xl flex items-center justify-between gap-6 py-8">
		<span class="label text-tx-3">{AUTHOR} · {year}</span>
		<div class="label flex items-center gap-5">
			<a
				href={SOCIALS.github}
				target="_blank"
				rel="me noopener"
				class="link-ui text-tx-3"
			>
				GitHub
			</a>
			<a
				href="/rss.xml"
				class="link-ui text-tx-3"
			>
				RSS
			</a>
		</div>
	</div>
</footer>
