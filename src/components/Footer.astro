---
import { AUTHOR, SOCIALS } from "../consts";
import ThemeToggle from "./ThemeToggle.astro";

const year = new Date().getFullYear();
---

<footer
  class='relative z-10 col-span-full -ml-px flex items-center justify-between gap-6 border-t border-ui bg-bg pt-8 pb-24 md:row-start-2'
>
  <span class='font-mono text-xs tracking-wide tabular-nums'
    >{AUTHOR} · {year}</span
  >
  <div
    class='flex items-center gap-6 font-mono text-xs tracking-wide tabular-nums'
  >
    <a
      href={SOCIALS.github}
      target='_blank'
      rel='me noopener'
      class='text-tx no-underline transition-colors hover:text-accent'
    >
      github
    </a>
    <a
      href='/rss.xml'
      class='text-tx no-underline transition-colors hover:text-accent'
    >
      rss
    </a>
    <ThemeToggle />
  </div>
</footer>
