---
import { PROJECT_STATUS } from '../consts';

interface Props {
	status: keyof typeof PROJECT_STATUS;
	class?: string;
}

const { status, class: className } = Astro.props;
const { label, dot } = PROJECT_STATUS[status];
---

<span
	class:list={['mark', `mark-${dot}`, className]}
	title={label}
	aria-hidden="true"
></span>
