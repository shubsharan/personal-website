---
/*
 * The mark that runs through the whole site: filled green for something I'm
 * actively building, filled grey for something shipped and left alone, a
 * hollow ring for something that ended. It sits inline in the home page
 * sentence and in the rail on the projects index, so it has to hold its
 * baseline at any type size — hence the em-based sizing.
 */
import { PROJECT_STATUS } from '../consts';

interface Props {
	status: keyof typeof PROJECT_STATUS;
	class?: string;
}

const { status, class: className } = Astro.props;
const { label, dot } = PROJECT_STATUS[status];
---

<span
	class:list={['mark', `mark-${dot}`, className]}
	title={label}
	aria-hidden="true"
></span>

<style>
	.mark {
		display: inline-block;
		width: 0.42em;
		height: 0.42em;
		border-radius: 50%;
		/* Optically centred on the x-height rather than the baseline. */
		vertical-align: 0.12em;
		flex: none;
	}

	.mark-live {
		background-color: var(--gr);
	}

	.mark-solid {
		background-color: var(--tx-3);
	}

	.mark-hollow {
		box-shadow: inset 0 0 0 1px var(--tx-3);
	}
</style>
