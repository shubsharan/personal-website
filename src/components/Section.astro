---
type Span = "content" | "wide" | "full";

interface Props {
  index?: string;
  span?: Span;
  class?: string;
}

const { index, span = "content", class: className } = Astro.props;

// Page columns inside the 12-column main grid. Content starts on the section rail
// and ends on the content rail; wide and full end on the outer right rail.
const spanClass: Record<Span, string> = {
  content: "md:col-start-2 md:col-span-8",
  wide: "md:col-start-2 md:col-span-11",
  full: "md:col-start-1 md:col-span-12",
};
---

<section
  class:list={[
    "col-span-full grid grid-cols-subgrid items-start",
    "has-[>div>:is(h1,header):first-child]:[&>p]:pt-1",
    "has-[>div>h2:first-child]:[&>p]:pt-0.5",
    className,
  ]}
>
  {
    index && (
      <p
        class='col-start-1 row-start-1 hidden font-mono text-xs tracking-wide text-muted-foreground tabular-nums select-none md:block'
        aria-hidden='true'
      >
        {index}
      </p>
    )
  }
  <div
    class:list={[
      "col-span-full flex min-w-0 flex-col gap-4 md:row-start-1 md:gap-6",
      "[&>:not(ul,figure,article)]:pr-4",
      spanClass[span],
    ]}
  >
    <slot />
  </div>
</section>
