---
type Span = "content" | "wide" | "full";

interface Props {
  index?: string;
  span?: Span;
  class?: string;
}

const { index, span = "content", class: className } = Astro.props;

// Columns within the 12-column page grid: 1 is the index gutter, content starts on the section rail at 2.
const spanClass: Record<Span, string> = {
  content: "md:col-start-2 md:col-span-7",
  wide: "md:col-start-2 md:col-span-10",
  full: "md:col-start-1 md:col-span-11",
};
---

<section
  class:list={[
    "col-span-full grid grid-cols-subgrid items-start",
    "has-[>div>:is(h1,header):first-child]:[&>p]:pt-1",
    "has-[>div>h2:first-child]:[&>p]:pt-0.5",
    className,
  ]}
>
  {
    index && (
      <p
        class='col-start-1 row-start-1 hidden font-mono text-xs tracking-wide text-tx-3 tabular-nums select-none md:block'
        aria-hidden='true'
      >
        {index}
      </p>
    )
  }
  <div
    class:list={[
      "col-span-full flex min-w-0 flex-col gap-4 md:row-start-1 md:gap-6",
      spanClass[span],
    ]}
  >
    <slot />
  </div>
</section>
