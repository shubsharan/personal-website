---
import StatusMark from '../components/StatusMark.astro';
import type { PROJECT_STATUS } from '../consts';
import Base from './Base.astro';

interface Props {
	title: string;
	description: string;
	label: string;
	rail: string;
	status?: keyof typeof PROJECT_STATUS;
	subtitle?: string;
	url?: string;
	updatedNote?: string;
	backHref: string;
	backLabel: string;
	canonicalURL?: string;
}

const {
	title,
	description,
	label,
	rail,
	status,
	subtitle,
	url,
	updatedNote,
	backHref,
	backLabel,
	canonicalURL,
} = Astro.props;

const displayUrl = url?.replace(/^https?:\/\//, '').replace(/\/$/, '');
---

<Base title={title} description={description} canonicalURL={canonicalURL}>
	<article class="container max-w-3xl prose">
		<header class="pt-6">
			<div class="label flex items-center justify-between gap-4 text-tx-3">
				<span class="flex items-center gap-2">
					{status && <StatusMark status={status} />}
					{label}
				</span>
				<span>{rail}</span>
			</div>

			<h1 class="page-title mt-5">
				{title}
			</h1>

			{subtitle && <p class="mt-3 text-tx-2 italic">{subtitle}</p>}

			{
				url && (
					<p class="mt-5">
						<a
							href={url}
							target="_blank"
							rel="noopener"
							class="label link-ui text-tx-2"
						>
							{displayUrl} ↗
						</a>
					</p>
				)
			}
		</header>

		<div class="prose mt-10">
			<slot />
		</div>

		<footer class="mt-14 flex items-center justify-between gap-4 border-t border-ui pt-6">
			<a
				href={backHref}
				class="label link-ui text-tx-3"
			>
				← {backLabel}
			</a>
			{updatedNote && <span class="label text-tx-3">{updatedNote}</span>}
		</footer>
	</article>
</Base>
