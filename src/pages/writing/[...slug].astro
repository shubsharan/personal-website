---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import { WRITING_KIND } from '../../consts';
import Entry from '../../layouts/Entry.astro';
import { longDate, monthYear } from '../../utils/dates';

export async function getStaticPaths() {
	const posts = await getCollection('writing', (p) => !p.data.draft);
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}
type Props = CollectionEntry<'writing'>;

const post = Astro.props;
const { Content } = await render(post);
const { title, description, kind, pubDate, updatedDate, subject } = post.data;
---

<Entry
	title={title}
	description={description}
	label={WRITING_KIND[kind]}
	rail={longDate(pubDate)}
	subtitle={subject}
	updatedNote={updatedDate ? `Updated ${monthYear(updatedDate)}` : undefined}
	backHref="/writing/"
	backLabel="All writing"
>
	<Content />
</Entry>
