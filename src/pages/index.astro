---
import { getCollection } from "astro:content";
import AsciiFrame from "../components/ascii/AsciiFrame.astro";
import EntryRow from "../components/EntryRow.astro";
import Section from "../components/Section.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import Base from "../layouts/Base.astro";
import { shortDate } from "../utils/dates";

const posts = (await getCollection("writing", (p) => !p.data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<Base title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <Section span='full'>
    <AsciiFrame />
  </Section>

  <Section index='01'>
    <h1 class='animate-rise'>Hey, I'm Shub.</h1>
  </Section>

  {
    posts.length > 0 && (
      <Section index='02'>
        <h2>Recent</h2>
        <ul class='divide-y divide-border border-t border-border'>
          {posts.map((post) => (
            <EntryRow
              href={`/writing/${post.id}/`}
              rail={shortDate(post.data.pubDate)}
              label={post.data.publication}
              title={post.data.title}
              description={post.data.description}
            />
          ))}
        </ul>
        <a
          href='/writing/'
          class='self-start font-mono text-xs tracking-wide text-muted-foreground tabular-nums no-underline transition-colors hover:text-foreground'
        >
          More →
        </a>
      </Section>
    )
  }
</Base>
