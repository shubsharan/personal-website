---
import { getCollection } from 'astro:content';
import AsciiFrame from '../components/ascii/AsciiFrame.astro';
import EntryRow from '../components/EntryRow.astro';
import StatusMark from '../components/StatusMark.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import Base from '../layouts/Base.astro';
import { monthYear } from '../utils/dates';

const projects = (await getCollection('projects', (p) => !p.data.draft)).sort(
	(a, b) => b.data.startDate.valueOf() - a.data.startDate.valueOf(),
);
const active = projects.filter((p) => p.data.status === 'active');
const past = projects.filter((p) => p.data.status !== 'active').slice(0, 3);

const posts = (await getCollection('writing', (p) => !p.data.draft))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

/** Serial commas for a spoken list: "a", "a and b", "a, b, and c". */
function joiner(index: number, total: number): string {
	if (index === 0) return '';
	if (index === total - 1) return total === 2 ? ' and ' : ', and ';
	return ', ';
}
---

<Base title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<AsciiFrame />

	<div class="container max-w-3xl pt-10 max-md:pt-4">
		<p class="rise text-2xl">
			I’m Shub. I make things.
		</p>

		<p class="rise mt-6 text-tx-2 [animation-delay:120ms]">
			{
				active.length > 0 ? (
					<Fragment>
						Right now that’s{' '}
						{active.map((project, i) => (
							<Fragment>
								{joiner(i, active.length)}
								<a
									href={`/projects/${project.id}/`}
									class="group text-tx no-underline whitespace-nowrap"
								>
									<StatusMark
										status={project.data.status}
										class="mr-[0.35em]"
									/><span class="link-underline">{project.data.title}</span>
								</a>
							</Fragment>
						))}
						.{' '}
					</Fragment>
				) : (
					<Fragment>Between projects at the moment. </Fragment>
				)
			}
			{
				past.length > 0 && (
					<Fragment>
						Before that,{' '}
						{past.map((project, i) => (
							<Fragment>
								{joiner(i, past.length)}
								<a
									href={`/projects/${project.id}/`}
									class="group text-tx no-underline whitespace-nowrap"
								>
									<StatusMark
										status={project.data.status}
										class="mr-[0.35em]"
									/><span class="link-underline">{project.data.title}</span>
								</a>
							</Fragment>
						))}
						.
					</Fragment>
				)
			}
		</p>

		<p class="rise mt-6 text-tx-2 [animation-delay:240ms]">
			In between I write —{' '}
			<a href="/writing/" class="link-underline text-tx whitespace-nowrap">essays</a>, and
			notes on whatever I’m reading — and I paint.
		</p>
	</div>

	{
		posts.length > 0 && (
			<section class="container max-w-3xl mt-20 max-md:mt-14">
				<h2 class="label mb-4 text-tx-3">Latest writing</h2>
				<ul>
					{posts.map((post) => (
						<EntryRow
							href={`/writing/${post.id}/`}
							rail={monthYear(post.data.pubDate)}
							label={post.data.publication}
							title={post.data.title}
							description={post.data.description}
						/>
					))}
				</ul>
				<a
					href="/writing/"
					class="label link-ui mt-6 inline-block text-tx-3"
				>
					All writing →
				</a>
			</section>
		)
	}
</Base>
