---
import { getCollection } from "astro:content";
import AsciiFrame from "../components/ascii/AsciiFrame.astro";
import EntryRow from "../components/EntryRow.astro";
import Section from "../components/Section.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import Base from "../layouts/Base.astro";
import { shortDate } from "../utils/dates";

const posts = (await getCollection("writing", (p) => !p.data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<Base title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <Section span='full'>
    <AsciiFrame />
  </Section>

  <Section index='01'>
    <h1 class='animate-rise'>Hello world.</h1>

    <p class='animate-rise delay-100'>
      I'm Shub. I’ve spent about a decade building products at the messy 0-to-1
      end — talking to users, mapping the workflow, and building the first
      version myself.
    </p>

    <p class='animate-rise delay-200'>
      In between I write —{" "}
      <a href='/writing/' class='whitespace-nowrap'>essays</a>, and notes on
      whatever I’m reading — and I <a href='/art/'>paint</a>.
    </p>
  </Section>

  {
    posts.length > 0 && (
      <Section index='02'>
        <h2>Latest writing</h2>
        <ul class='divide-y divide-ui border-t border-ui'>
          {posts.map((post) => (
            <EntryRow
              href={`/writing/${post.id}/`}
              rail={shortDate(post.data.pubDate)}
              label={post.data.publication}
              title={post.data.title}
              description={post.data.description}
            />
          ))}
        </ul>
        <a
          href='/writing/'
          class='self-start font-mono text-xs tracking-wide text-tx-3 tabular-nums no-underline transition-colors hover:text-tx'
        >
          All writing →
        </a>
      </Section>
    )
  }
</Base>
