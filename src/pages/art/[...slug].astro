---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import { PROJECT_STATUS } from '../../consts';
import Entry from '../../layouts/Entry.astro';
import { span } from '../../utils/dates';

export async function getStaticPaths() {
	const art = await getCollection('art');
	return art.map((art) => ({
		params: { slug: art.id },
		props: art,
	}));
}
type Props = CollectionEntry<'art'>;

const art = Astro.props;
const { Content } = await render(art);
const { title, description, createdDate } =
	art.data;
---

<Entry
	title={title}
	description={description}
	rail={span(createdDate)}
	label="Art"
	backHref="/art/"
	backLabel="All art"
>
	<Content />
</Entry>
