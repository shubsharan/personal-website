---
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';
import { SITE_TITLE, SOCIALS } from '../../consts';
import Base from '../../layouts/Base.astro';

// Newest first. Entries without a date sort to the top.
const art = (await getCollection('art')).sort(
	(a, b) =>
		(b.data.createdDate ?? new Date()).valueOf() -
		(a.data.createdDate ?? new Date()).valueOf(),
);

const description = 'Paintings and photographs.';
const iconSize = 22;
---

<Base title={`Art · ${SITE_TITLE}`} description={description}>
	<div class="container max-w-3xl">
		<header class="page-head">
			<h1 class="page-title">Art</h1>
			<p class="mt-3 text-tx-2">{description}</p>
			<p class="label mt-5 text-tx-3">
				<a
					href={SOCIALS.instagram}
					target="_blank"
					rel="noopener"
					class="link-ui"
				>
					@shubadub on Instagram ↗
				</a>
			</p>
		</header>

		{
			art.length > 0 ? (
				<ul class="grid grid-cols-3 gap-1" data-art-grid>
					{art.map((item, i) => (
						<li>
							<button
								type="button"
								class="group block aspect-square w-full overflow-hidden bg-ui-2"
								data-art-tile
								data-index={i}
								data-src={item.data.src}
								data-alt={item.data.alt}
								data-caption={item.data.caption ?? ''}
								aria-label={`View ${item.data.alt}`}
							>
								<img
									src={item.data.src}
									alt={item.data.alt}
									loading="lazy"
									class="h-full w-full object-cover transition-opacity duration-150 group-hover:opacity-90"
								/>
							</button>
						</li>
					))}
				</ul>
			) : (
				<p class="empty-state">
					Nothing here yet. Add rows to <code>src/content/art.yaml</code> and
					images to <code>public/art/</code>.
				</p>
			)
		}
	</div>

	<dialog
		class="m-0 h-dvh max-h-none w-full max-w-none border-0 bg-bg p-0 text-tx backdrop:bg-bg open:flex open:flex-col"
		aria-label="Artwork viewer"
		data-art-lightbox
	>
		<div class="container max-w-3xl flex justify-end py-4">
			<button
				type="button"
				class="inline-flex items-center justify-center rounded-sm text-tx-2 hover:text-tx"
				aria-label="Close viewer"
				autofocus
				data-art-close
			>
				<Icon name="lucide:x" width={iconSize} height={iconSize} aria-hidden="true" />
			</button>
		</div>

		<div class="flex flex-1 items-center justify-center gap-3 px-4 pb-12 md:gap-5">
			<button
				type="button"
				class="inline-flex shrink-0 items-center justify-center rounded-sm text-tx-2 hover:text-tx"
				aria-label="Previous"
				data-art-prev
			>
				<Icon name="lucide:chevron-left" width={iconSize} height={iconSize} aria-hidden="true" />
			</button>

			<figure class="flex min-w-0 flex-col items-center">
				<img
					class="max-h-[80dvh] w-auto max-w-full object-contain"
					alt=""
					data-art-image
				/>
				<figcaption class="mt-3 max-w-prose text-center text-sm text-tx-2" hidden data-art-caption></figcaption>
			</figure>

			<button
				type="button"
				class="inline-flex shrink-0 items-center justify-center rounded-sm text-tx-2 hover:text-tx"
				aria-label="Next"
				data-art-next
			>
				<Icon name="lucide:chevron-right" width={iconSize} height={iconSize} aria-hidden="true" />
			</button>
		</div>
	</dialog>
</Base>

<script>
	const dialog = document.querySelector<HTMLDialogElement>('[data-art-lightbox]');
	const imgEl = dialog?.querySelector<HTMLImageElement>('[data-art-image]');
	const captionEl = dialog?.querySelector<HTMLElement>('[data-art-caption]');
	const tiles = Array.from(
		document.querySelectorAll<HTMLButtonElement>('[data-art-tile]'),
	);

	let current = 0;

	function show(index: number) {
		const n = tiles.length;
		if (!n || !imgEl) return;
		current = (index + n) % n;
		const tile = tiles[current];
		imgEl.src = tile.dataset.src ?? '';
		imgEl.alt = tile.dataset.alt ?? '';
		const caption = tile.dataset.caption ?? '';
		if (captionEl) {
			captionEl.textContent = caption;
			captionEl.hidden = caption === '';
		}
	}

	function open(index: number) {
		if (!dialog) return;
		show(index);
		if (!dialog.open) dialog.showModal();
	}

	tiles.forEach((tile, i) => tile.addEventListener('click', () => open(i)));

	dialog?.addEventListener('click', (e) => {
		const target = e.target as Element;
		if (target.closest('[data-art-close]')) return dialog.close();
		if (target.closest('[data-art-prev]')) return show(current - 1);
		if (target.closest('[data-art-next]')) return show(current + 1);
		// A click on the backdrop area resolves to the dialog element itself.
		if (target === dialog) dialog.close();
	});

	document.addEventListener('keydown', (e) => {
		if (!dialog?.open) return;
		if (e.key === 'ArrowLeft') show(current - 1);
		else if (e.key === 'ArrowRight') show(current + 1);
	});
</script>
