---
import { AUTHOR_EMAIL, SITE_TITLE, SOCIALS } from "../consts";
import Section from "../components/Section.astro";
import Base from "../layouts/Base.astro";

const description = "Get in touch.";

const links = [
  { label: "Email", href: `mailto:${AUTHOR_EMAIL}`, value: AUTHOR_EMAIL },
  { label: "GitHub", href: SOCIALS.github, value: SOCIALS.github },
  { label: "LinkedIn", href: SOCIALS.linkedin, value: SOCIALS.linkedin },
];
---

<Base title={`Contact | ${SITE_TITLE}`} description={description}>
  <Section index='01'>
    <h1>Contact</h1>
    <p>Call me beep me if you want to reach me.</p>

    <ul class='divide-y divide-border border-y border-border'>
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              target={link.href.startsWith("mailto:") ? undefined : "_blank"}
              rel={link.href.startsWith("mailto:") ? undefined : "me noopener"}
              class='flex items-baseline justify-between gap-6 px-4 py-4 text-foreground no-underline transition-colors hover:text-primary'
            >
              <span class='font-mono text-xs tracking-wide text-muted-foreground tabular-nums'>
                {link.label}
              </span>
              <span>{link.value}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </Section>
</Base>
