---
import { AUTHOR_EMAIL, SITE_TITLE, SOCIALS } from '../consts';
import Base from '../layouts/Base.astro';

const description = 'Get in touch.';

const links = [
	{ label: 'Email', href: `mailto:${AUTHOR_EMAIL}`, value: AUTHOR_EMAIL },
	{ label: 'GitHub', href: SOCIALS.github, value: '@shubsharan' },
	{ label: 'LinkedIn', href: SOCIALS.linkedin, value: '@shubsharan' },
	{ label: 'Instagram', href: SOCIALS.instagram, value: '@shubadub' },
];
---

<Base title={`Contact · ${SITE_TITLE}`} description={description}>
	<div class="container max-w-3xl">
		<header class="page-head">
			<h1 class="page-title">
				Contact
			</h1>
			<p class="mt-3 text-tx-2">
				Reach out by email, or find me elsewhere below.
			</p>
		</header>

		<ul>
			{
				links.map((link) => (
					<li class="border-t border-ui py-5 last:border-b">
						<a
							href={link.href}
							target={link.href.startsWith('mailto:') ? undefined : '_blank'}
							rel={link.href.startsWith('mailto:') ? undefined : 'me noopener'}
							class="flex items-baseline justify-between gap-6 no-underline"
						>
							<span class="label text-tx-2">{link.label}</span>
							<span class="text-tx transition-colors duration-150 hover:text-tx-2">
								{link.value}
							</span>
						</a>
					</li>
				))
			}
		</ul>
	</div>
</Base>
