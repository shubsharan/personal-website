{
  "name": "",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "content:sync": "node scripts/content-sync.mjs",
    "test:content": "node --test scripts/content-sync.test.mjs",
    "dev": "astro dev",
    "build": "astro build && node scripts/precompress.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "test": "node --test scripts/*.test.mjs src/components/ascii/*.test.mjs",
    "ascii:encode": "npm run ascii:encode:coarse && npm run ascii:encode:default && npm run ascii:encode:fine",
    "ascii:encode:coarse": "node scripts/ascii-encode.mjs media/apollo-13-workbench.mp4 --crop 640:262:0:10 --cols 120 --rows 30 --color --out src/assets/apollo-ascii-coarse.json",
    "ascii:encode:default": "node scripts/ascii-encode.mjs media/apollo-13-workbench.mp4 --crop 640:262:0:10 --cols 180 --rows 45 --color --out src/assets/apollo-ascii.json",
    "ascii:encode:fine": "node scripts/ascii-encode.mjs media/apollo-13-workbench.mp4 --crop 640:262:0:10 --cols 240 --rows 60 --color --out src/assets/apollo-ascii-fine.json",
    "generate-types": "wrangler types"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@chenglou/pretext": "0.0.8",
    "@iconify-json/lucide": "^1.2.121",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.4",
    "astro-icon": "^1.1.5",
    "sharp": "^0.35.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "ffmpeg-static": "^5.3.0",
    "gray-matter": "^4.0.3",
    "rss-parser": "^3.13.0",
    "sanitize-html": "^2.17.7",
    "turndown": "^7.2.4",
    "typescript": "^6.0.3",
    "wrangler": "^4.136.3"
  }
}
